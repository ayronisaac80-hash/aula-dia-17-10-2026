import random

print("### jogo da adivinhação ###")
print("tente adivinhar um número de 1 a 10.")

secreta = random.randint(1,10)
tentativa = 0
acertou = False

while not acertou:
    palpite = int(input("informe um número:  "))
    tentativa = tentativa + 1
    if palpite < secreta:
        print ("o número é maior!")
    elif palpite > secreta:
        print ("o número é menor")
    else:
        print (f"acertou o número {secreta}")
